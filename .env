# fbref-scraper configuration
# Copy these values into `.env.local` (git-ignored) to override them locally.
# CLI flags (--headless, --storage_type) override both files.

# --- Browser ---
# Run Chrome headless. fbref may block headless browsers, so False (headed) is recommended.
HEADLESS=False

# --- Storage ---
# Where to save scraped reports: json | postgresql | both
#  json        save report as a JSON file under storage/
#  postgresql  upsert report into PostgreSQL (requires DB_CONNECTION_STRING)
#  both        do both
STORAGE_TYPE=json

# --- PostgreSQL ---
# Connection string used when STORAGE_TYPE is postgresql or both.
# Example: postgresql://user:password@localhost:5432/fbref
DB_CONNECTION_STRING=
